---
Name: CuteRendererC
SwiftInferImportAsMember: true

# MARK: - Type Renames

Typedefs:
  # Basic math types become Swift-friendly names
  - Name: CR_V2
    SwiftName: CRVector2
    SwiftBridge: Vector2

  - Name: CR_Color
    SwiftName: CRColor
    SwiftBridge: Color

  - Name: CR_Pixel
    SwiftName: CRPixel
    SwiftBridge: Pixel

  - Name: CR_AABB
    SwiftName: CRAABB
    SwiftBridge: AABB

  - Name: CR_Circle
    SwiftName: CRCircle
    SwiftBridge: Circle

  - Name: CR_Capsule
    SwiftName: CRCapsule
    SwiftBridge: Capsule

  - Name: CR_Rect
    SwiftName: CRRect
    SwiftBridge: Rect

  # Handle types
  - Name: CR_Texture
    SwiftName: CRTextureHandle

  - Name: CR_Canvas
    SwiftName: CRCanvasHandle

  - Name: CR_Shader
    SwiftName: CRShaderHandle

  - Name: CR_Material
    SwiftName: CRMaterialHandle

  - Name: CR_Mesh
    SwiftName: CRMeshHandle

Enumerators:
  # Pixel format Swift names
  - Name: CR_PIXEL_FORMAT_INVALID
    SwiftName: PixelFormat.invalid
  - Name: CR_PIXEL_FORMAT_A8_UNORM
    SwiftName: PixelFormat.a8Unorm
  - Name: CR_PIXEL_FORMAT_R8_UNORM
    SwiftName: PixelFormat.r8Unorm
  - Name: CR_PIXEL_FORMAT_R8G8_UNORM
    SwiftName: PixelFormat.r8g8Unorm
  - Name: CR_PIXEL_FORMAT_R8G8B8A8_UNORM
    SwiftName: PixelFormat.r8g8b8a8Unorm
  - Name: CR_PIXEL_FORMAT_D16_UNORM
    SwiftName: PixelFormat.d16Unorm
  - Name: CR_PIXEL_FORMAT_D24_UNORM
    SwiftName: PixelFormat.d24Unorm
  - Name: CR_PIXEL_FORMAT_D32_FLOAT
    SwiftName: PixelFormat.d32Float

  # Filter
  - Name: CR_FILTER_NEAREST
    SwiftName: TextureFilter.nearest
  - Name: CR_FILTER_LINEAR
    SwiftName: TextureFilter.linear

  # Wrap mode
  - Name: CR_WRAP_MODE_REPEAT
    SwiftName: WrapMode.repeat
  - Name: CR_WRAP_MODE_CLAMP_TO_EDGE
    SwiftName: WrapMode.clampToEdge
  - Name: CR_WRAP_MODE_MIRRORED_REPEAT
    SwiftName: WrapMode.mirroredRepeat

  # Blend factor
  - Name: CR_BLEND_FACTOR_ZERO
    SwiftName: BlendFactor.zero
  - Name: CR_BLEND_FACTOR_ONE
    SwiftName: BlendFactor.one
  - Name: CR_BLEND_FACTOR_SRC_ALPHA
    SwiftName: BlendFactor.srcAlpha
  - Name: CR_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
    SwiftName: BlendFactor.oneMinusSrcAlpha

  # Backend type
  - Name: CR_BACKEND_INVALID
    SwiftName: BackendType.invalid
  - Name: CR_BACKEND_VULKAN
    SwiftName: BackendType.vulkan
  - Name: CR_BACKEND_D3D11
    SwiftName: BackendType.d3d11
  - Name: CR_BACKEND_D3D12
    SwiftName: BackendType.d3d12
  - Name: CR_BACKEND_METAL
    SwiftName: BackendType.metal
  - Name: CR_BACKEND_GLES3
    SwiftName: BackendType.gles3

Functions:
  # Initialization
  - Name: cr_init
    SwiftName: CuteRenderer.initialize(windowHandle:)

  - Name: cr_shutdown
    SwiftName: CuteRenderer.shutdown()

  - Name: cr_query_backend
    SwiftName: CuteRenderer.queryBackend()

  # Texture functions - make them member methods
  - Name: cr_make_texture
    SwiftName: CRTextureHandle.create(params:)

  - Name: cr_destroy_texture
    SwiftName: CRTextureHandle.destroy(self:)

  - Name: cr_texture_update
    SwiftName: CRTextureHandle.update(self:data:size:)

  - Name: cr_texture_update_mip
    SwiftName: CRTextureHandle.updateMip(self:data:size:level:)

  - Name: cr_generate_mipmaps
    SwiftName: CRTextureHandle.generateMipmaps(self:)

  # Canvas functions
  - Name: cr_make_canvas
    SwiftName: CRCanvasHandle.create(params:)

  - Name: cr_destroy_canvas
    SwiftName: CRCanvasHandle.destroy(self:)

  - Name: cr_apply_canvas
    SwiftName: CRCanvasHandle.apply(self:)

  - Name: cr_clear_color
    SwiftName: CRCanvasHandle.clear(color:)

  - Name: cr_clear_color_depth
    SwiftName: CRCanvasHandle.clear(color:depth:)

  # Shader functions
  - Name: cr_shader_directory
    SwiftName: CRShaderHandle.setDirectory(_:)

  - Name: cr_make_shader
    SwiftName: CRShaderHandle.create(vertexPath:fragmentPath:)

  - Name: cr_make_shader_from_source
    SwiftName: CRShaderHandle.create(vertexSource:fragmentSource:)

  - Name: cr_destroy_shader
    SwiftName: CRShaderHandle.destroy(self:)

  # Material functions
  - Name: cr_make_material
    SwiftName: CRMaterialHandle.create()

  - Name: cr_destroy_material
    SwiftName: CRMaterialHandle.destroy(self:)

  - Name: cr_material_set_uniform_float
    SwiftName: CRMaterialHandle.setUniform(self:name:floatValue:)

  - Name: cr_material_set_uniform_v2
    SwiftName: CRMaterialHandle.setUniform(self:name:vector:)

  - Name: cr_material_set_uniform_color
    SwiftName: CRMaterialHandle.setUniform(self:name:color:)

  - Name: cr_material_set_texture
    SwiftName: CRMaterialHandle.setTexture(self:name:texture:)

  # Mesh functions
  - Name: cr_make_mesh
    SwiftName: CRMeshHandle.create(attributes:count:stride:)

  - Name: cr_destroy_mesh
    SwiftName: CRMeshHandle.destroy(self:)

  - Name: cr_mesh_update_vertices
    SwiftName: CRMeshHandle.updateVertices(self:data:size:count:)

  - Name: cr_mesh_update_indices
    SwiftName: CRMeshHandle.updateIndices(self:data:size:count:use32Bit:)

  - Name: cr_apply_mesh
    SwiftName: CRMeshHandle.apply(self:)

  # Draw state functions
  - Name: cr_draw_push_layer
    SwiftName: CuteDraw.pushLayer(_:)

  - Name: cr_draw_pop_layer
    SwiftName: CuteDraw.popLayer()

  - Name: cr_draw_push_color
    SwiftName: CuteDraw.pushColor(_:)

  - Name: cr_draw_pop_color
    SwiftName: CuteDraw.popColor()

  - Name: cr_draw_push_antialias
    SwiftName: CuteDraw.pushAntialias(_:)

  - Name: cr_draw_pop_antialias
    SwiftName: CuteDraw.popAntialias()

  # Shape drawing functions
  - Name: cr_draw_quad
    SwiftName: CuteDraw.quad(_:thickness:chubbiness:)

  - Name: cr_draw_quad_fill
    SwiftName: CuteDraw.quadFill(_:chubbiness:)

  - Name: cr_draw_circle
    SwiftName: CuteDraw.circle(center:radius:thickness:)

  - Name: cr_draw_circle_fill
    SwiftName: CuteDraw.circleFill(center:radius:)

  - Name: cr_draw_capsule
    SwiftName: CuteDraw.capsule(from:to:radius:thickness:)

  - Name: cr_draw_capsule_fill
    SwiftName: CuteDraw.capsuleFill(from:to:radius:)

  - Name: cr_draw_tri
    SwiftName: CuteDraw.triangle(_:_:_:thickness:chubbiness:)

  - Name: cr_draw_tri_fill
    SwiftName: CuteDraw.triangleFill(_:_:_:chubbiness:)

  - Name: cr_draw_line
    SwiftName: CuteDraw.line(from:to:thickness:)

  - Name: cr_draw_polyline
    SwiftName: CuteDraw.polyline(_:count:thickness:loop:)

  - Name: cr_draw_flush
    SwiftName: CuteDraw.flush()

Tags:
  # Struct member renames for better Swift access
  - Name: CR_V2
    SwiftName: CRVector2

  - Name: CR_Color
    SwiftName: CRColor

  - Name: CR_TextureParams
    SwiftName: CRTextureParams

  - Name: CR_CanvasParams
    SwiftName: CRCanvasParams
